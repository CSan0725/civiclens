# CivicLens — root environment template.
# Copy to `.env` and fill in. `.env` is git-ignored; never commit real keys.
#
# Scope of this file: everything that runs from the repo root — dbmate migrations
# (packages/db) and the Next.js app (apps/web). The Python ETL has its own copy at
# pipelines/etl/.env.example with the same variable names.

# ---------------------------------------------------------------------------
# Database (Neon Postgres + PostGIS — Deployment-Architecture-Report Stack A)
# ---------------------------------------------------------------------------
# Pooled (PgBouncer) connection — used by the Next.js app on Vercel serverless.
# Neon pooled hosts carry a `-pooler` suffix in the hostname.
DATABASE_URL=postgres://postgres:postgres@localhost:55432/civiclens?sslmode=disable

# Direct/unpooled connection — REQUIRED for dbmate migrations and `drizzle-kit pull`.
# DDL and introspection must not go through PgBouncer transaction pooling.
DATABASE_URL_UNPOOLED=postgres://postgres:postgres@localhost:55432/civiclens?sslmode=disable

# ---------------------------------------------------------------------------
# Upstream data source API keys (P1 — not used by the P0 scaffold)
# ---------------------------------------------------------------------------
# https://api.congress.gov/sign-up/  — 5,000 req/hour
CONGRESS_GOV_API_KEY=
# https://api.data.gov/signup/  — GovInfo uses api.data.gov keys
GOVINFO_API_KEY=
# https://api.open.fec.gov/developers/
FEC_API_KEY=

# ---------------------------------------------------------------------------
# Object storage for provenance snapshots (Cloudflare R2, S3-compatible)
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# PRIVATE. Raw upstream payloads, the byte-level audit trail behind NFR-5.
R2_BUCKET=civiclens-snapshots

# PUBLIC-READ, with a CORS rule. The district TopoJSON the map fetches straight
# from the browser (Deployment-Architecture-Report 2c). Kept apart from the
# snapshot bucket on purpose: raw provenance payloads must never be world-
# readable. R2_PUBLIC_BASE_URL is the bucket's r2.dev subdomain or a custom
# domain; the web app joins it with district.topojson_r2_key.
R2_PUBLIC_BUCKET=civiclens-public
R2_PUBLIC_BASE_URL=
