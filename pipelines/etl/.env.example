# CivicLens ETL environment template.
# Copy to `.env` in this directory (or export these in the shell / CI secrets).
# `.env` is git-ignored; never commit real keys.
#
# Variable names match the repo-root .env.example so a single set of secrets
# works for dbmate, the web app, and this pipeline.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The ETL writes DDL-adjacent bulk loads and must NOT go through PgBouncer
# transaction pooling — use the direct/unpooled Neon endpoint.
DATABASE_URL=postgres://postgres:postgres@localhost:55432/civiclens

# ---------------------------------------------------------------------------
# Upstream API keys
# ---------------------------------------------------------------------------
# Congress.gov — bills, members, committees, actions, House votes.
# Sign up: https://api.congress.gov/sign-up/
# The docs say 5,000 req/hour; the live header says X-Ratelimit-Limit: 20000.
# The client reads the header rather than trusting either figure.
# House vote coverage is the 115th Congress (2017) onward, not 2023 as the PRD
# assumed — see docs/P1-source-verification.md.
CONGRESS_GOV_API_KEY=

# GovInfo — Congressional Record granules (speeches).
# GovInfo authenticates with an api.data.gov key: https://api.data.gov/signup/
GOVINFO_API_KEY=

# FEC / openFEC — candidates and campaign finance.
# Sign up: https://api.open.fec.gov/developers/
FEC_API_KEY=

# No key required, listed for completeness:
#   senate.gov XML       — https://www.senate.gov/legislative/LIS/roll_call_lists/
#   clerk.house.gov XML  — https://clerk.house.gov/evs/
#   Census Geocoder      — https://geocoding.geo.census.gov/geocoder/
#   Census TIGER/CB      — https://www2.census.gov/geo/tiger/
#   Voteview             — https://voteview.com/static/data/out/  (CSV downloads)

# ---------------------------------------------------------------------------
# Provenance snapshots -> Cloudflare R2 (S3-compatible, zero egress)
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=civiclens-snapshots
R2_ENDPOINT=

# ---------------------------------------------------------------------------
# senate.gov access
# ---------------------------------------------------------------------------
# senate.gov sits behind Akamai, which returns 403 to this honest default from
# some networks while accepting a browser User-Agent. The default stays honest
# on purpose; the block may be IP-related, so it can work from a US-hosted
# runner. Read docs/P1-source-verification.md (Finding 7) before changing it.
SENATE_USER_AGENT=CivicLens/0.1 (open civic data; +https://github.com/)

# ---------------------------------------------------------------------------
# Run behaviour
# ---------------------------------------------------------------------------
# Politeness delay between upstream requests, seconds.
ETL_REQUEST_DELAY=0.2
# Log level: DEBUG | INFO | WARNING | ERROR
ETL_LOG_LEVEL=INFO
# Attempts before a transient failure (429/5xx/network) gives up.
ETL_MAX_RETRIES=5
# Earliest Congress to backfill. 101 = 1989-1991, which covers the confirmed
# start years (senate.gov XML 1989~, clerk.house.gov XML 1990~).
ETL_BACKFILL_FROM_CONGRESS=101
