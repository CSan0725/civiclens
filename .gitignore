# --- dependencies ---
node_modules/
.pnpm-store/
.venv/
__pycache__/
*.py[cod]

# --- build output ---
.next/
out/
dist/
build/
*.tsbuildinfo

# --- turbo ---
.turbo/

# --- env / secrets ---
.env
.env.*
!.env.example

# --- generated artifacts (see root CLAUDE.md 생성물 git 정책) ---
# apps/web/src/db/generated/{schema,relations}.ts are NOT ignored on purpose:
# Deployment-Architecture-Report §3/§4 requires the drizzle-kit pull output to
# be committed so CI can `git diff --exit-code` it and fail on schema drift.
# Both files are byte-deterministic across runs (verified).
#
# The rest of drizzle-kit pull's output is not: it also emits a snapshot .sql
# with a RANDOM generated filename plus a meta/ journal, neither of which the
# app consumes and both of which would break the drift check.
apps/web/src/db/generated/*.sql
apps/web/src/db/generated/meta/
data/
logs/
output/
.ruff_cache/
.mypy_cache/
.pytest_cache/

# --- Next.js 16 generated files ---
# All three are rewritten by `next dev` / `next build`, so tracking them means
# a dirty tree after every local run and a diff that flips back and forth
# between the dev and build variants.
#
# next-env.d.ts points at .next/dev/types under `next dev` and .next/types
# under `next build`; CI builds, developers dev, and the file churned between
# them. It is generated on demand and marked "should not be edited".
#
# AGENTS.md / CLAUDE.md are re-emitted by `next dev` (see
# node_modules/next/dist/server/lib/generate-agent-files.js). Whether this repo
# wants Next's agent instructions is a project decision, not a build artifact
# to accumulate; the workspace charter lives at D:\William_Workspace\CLAUDE.md.
apps/web/next-env.d.ts
apps/web/AGENTS.md
apps/web/CLAUDE.md

